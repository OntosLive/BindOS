{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BindOS Scene",
  "type": "object",
  "required": ["id", "actors", "nodes", "edges"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "nodes": { "type": "array" },
    "edges": { "type": "array" },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "target", "epistemic"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "enum": [
              "classifies",
              "governs",
              "permits",
              "forbids",
              "sanctions",
              "reframes",
              "updates",
              "blocks"
            ]
          },
          "label": { "type": "string" },
          "sourceNodeId": { "type": "string" },
          "target": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["node", "edge", "operator"] },
              "id": { "type": "string" }
            }
          },
          "epistemic": {
            "enum": ["observed", "inferred", "suggested"]
          }
        }
      }
    },
    "moves": { "type": "array" },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "t", "kind", "label"],
        "properties": {
          "id": { "type": "string" },
          "t": { "type": "number" },
          "actorId": { "type": "string" },
          "kind": {
            "enum": [
              "approach",
              "withdraw",
              "rescue",
              "dependency",
              "guilt-signal",
              "compensate",
              "demand",
              "relief",
              "pressure",
              "repair-attempt",
              "criterion-set",
              "criterion-met",
              "criterion-shift",
              "other"
            ]
          },
          "label": { "type": "string" },
          "magnitude": { "type": "number" },
          "respondsTo": { "type": "string" },
          "epistemic": {
            "enum": ["observed", "inferred", "suggested"]
          }
        }
      }
    }
  }
}
