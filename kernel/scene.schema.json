{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BindOS Scene",
  "type": "object",
  "required": ["id", "actors", "nodes", "edges"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "actors": { "type": "array" },
    "nodes": { "type": "array" },
    "edges": { "type": "array" },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "target", "epistemic"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "enum": [
              "classifies",
              "governs",
              "permits",
              "forbids",
              "sanctions",
              "reframes",
              "updates",
              "blocks",
              "reinforces"
            ]
          },
          "label": { "type": "string" },
          "sourceNodeId": { "type": "string" },
          "sourceActorId": { "type": "string" },
          "targetActorId": { "type": "string" },
          "channel": {
            "enum": [
              "verbal",
              "text",
              "prosody",
              "facial",
              "gaze",
              "gesture",
              "posture",
              "proximity",
              "touch",
              "silence",
              "timing",
              "group-response",
              "environmental",
              "institutional",
              "algorithmic",
              "other"
            ]
          },
          "target": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["node", "move", "edge", "operator"] },
              "id": { "type": "string" }
            }
          },
          "influence": {
            "type": "object",
            "required": [
              "moveId",
              "direction",
              "magnitude",
              "conductance",
              "gain",
              "reality"
            ],
            "properties": {
              "moveId": { "type": "string" },
              "direction": { "enum": ["cost", "relief"] },
              "magnitude": { "type": "number", "minimum": 0 },
              "conductance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "gain": { "type": "number", "minimum": 0 },
              "reality": { "enum": ["actual", "expected"] }
            }
          },
          "epistemic": {
            "enum": ["observed", "inferred", "suggested"]
          }
        }
      }
    },
    "moves": { "type": "array" },
    "timeline": { "type": "array" }
  }
}
