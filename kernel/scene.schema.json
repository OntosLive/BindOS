{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BindOS Scene",
  "type": "object",
  "required": ["id", "actors", "nodes", "edges"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "nodes": { "type": "array" },
    "edges": { "type": "array" },
    "moves": { "type": "array" },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "t", "kind", "label"],
        "properties": {
          "id": { "type": "string" },
          "t": { "type": "number" },
          "actorId": { "type": "string" },
          "kind": {
            "enum": [
              "approach",
              "withdraw",
              "rescue",
              "dependency",
              "guilt-signal",
              "compensate",
              "demand",
              "relief",
              "pressure",
              "repair-attempt",
              "criterion-set",
              "criterion-met",
              "criterion-shift",
              "other"
            ]
          },
          "label": { "type": "string" },
          "magnitude": { "type": "number" },
          "respondsTo": { "type": "string" },
          "epistemic": {
            "enum": ["observed", "inferred", "suggested"]
          }
        }
      }
    }
  }
}
